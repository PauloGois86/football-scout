# ─── Football Scout — Setup ─────────────────────────────────────────
#
# 1. Regista-te em https://dashboard.api-football.com
#    Plano FREE: 100 requests/dia (suficiente para testar)
#    Plano PRO:  ~8€/mês — odds em tempo real, mais ligas, stats avançadas
#
# 2. Copia a tua API key para o ficheiro .env:

API_FOOTBALL_KEY=a_tua_chave_aqui

# ─── Para arrancar ───────────────────────────────────────────────────
#
#   cp .env.example .env
#   nano .env          # coloca a tua chave
#   docker compose up -d
#
#   Dashboard: http://IP_DO_SERVIDOR:3501
#   API:       http://IP_DO_SERVIDOR:3500
#
# ─── Para adicionar ao Nginx Proxy Manager (NPM) ────────────────────
#
#   Cria um proxy host:
#   Domain:      scout.teu-dominio.duckdns.org
#   Forward:     football-scout-ui  port 80  (ou IP:3501)
#   SSL:         Let's Encrypt
#
# ─── Roadmap / ML futuro ─────────────────────────────────────────────
#
#   Ver README.md — modelo Dixon-Coles + backtest walk-forward já implementados.
#
# ─── Estrutura de ficheiros ──────────────────────────────────────────
#
#   football-scout/
#   ├── backend/
#   │   ├── server.js          ← API Node.js + lógica de análise
#   │   ├── package.json
#   │   └── Dockerfile
#   ├── frontend/
#   │   └── index.html         ← Dashboard completo (HTML/CSS/JS)
#   ├── docker/
#   │   └── nginx.conf         ← Config Nginx para servir o frontend
#   ├── docker-compose.yml
#   └── .env                   ← A tua API key (não commitar!)

# ── football-data.org (alternativa gratuita, sem limite diário) ───────
# Registo: https://www.football-data.org/client/register
# Plano FREE: 10 req/min, sem limite diário
FOOTBALL_DATA_KEY=a_tua_chave_football_data

# ── The Odds API (odds em tempo real de 40+ casas de apostas) ───────
# Registo gratuito: https://the-odds-api.com — 500 requests/mês FREE
ODDS_API_KEY=a_tua_chave_odds_api

# ── Segurança ─────────────────────────────────────────────────────
# Protege /api/admin/* e o import da BD. Gera um valor aleatório, ex.:
#   openssl rand -hex 24
ADMIN_TOKEN=

# ── Modelo ────────────────────────────────────────────────────────
# Peso do modelo Dixon-Coles na previsão final (o resto vem das odds do mercado).
# 0 = só mercado · 1 = só modelo. Ajusta com base no backtest (node backtest.js).
MODEL_WEIGHT=0.35
# EV mínimo (valor esperado) para marcar uma aposta como "VALUE"
EV_THRESHOLD=0.03
