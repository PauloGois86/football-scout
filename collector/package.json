{
  "name": "football-scout-collector",
  "version": "1.0.0",
  "main": "collect.js",
  "scripts": {
    "status":           "node collect.js --mode=status",
    "backfill":         "node collect.js --mode=backfill",
    "backfill:2024":    "node collect.js --mode=backfill --season=2024",
    "backfill:force":   "node collect.js --mode=backfill --force",
    "daily":            "node collect.js --mode=daily",
    "export":           "node collect.js --mode=export",
    "alt:status":       "node collect-alt.js --mode=status",
    "alt:backfill":     "node collect-alt.js --mode=backfill",
    "alt:backfill:2024":"node collect-alt.js --mode=backfill --season=2024",
    "alt:daily":        "node collect-alt.js --mode=daily",
    "import:history":   "node import-fdcouk.js",
    "backtest":         "node backtest.js",
    "backtest:sim":     "node backtest.js --simulate",
    "backtest:market":  "node backtest-market.js",
    "test":             "node --test ../shared/model.test.js"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "better-sqlite3": "^9.4.0",
    "dotenv": "^16.4.0"
  }
}
